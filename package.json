{
  "name": "seo-monitor",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-env.js && node scripts/sync-env.js",
    "env:sync": "node scripts/sync-env.js",
    "predev": "node scripts/sync-env.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "schedule:run": "tsx scripts/run-scheduled-push.ts",
    "schedule:daemon": "tsx scripts/scheduler-daemon.ts",
    "scf:package": "node scripts/scf-package.js",
    "scf:test": "node scripts/scf-test-local.js",
    "scf:deploy": "node scripts/scf-package.js",
    "seonaut:up": "docker compose -f deploy/seonaut/docker-compose.yml up -d",
    "seonaut:down": "docker compose -f deploy/seonaut/docker-compose.yml down",
    "seonaut:logs": "docker compose -f deploy/seonaut/docker-compose.yml logs -f app",
    "audit:lighthouse": "tsx scripts/audit-lighthouse.ts",
    "audit:site-audit-seo": "tsx scripts/audit-site-audit-seo.ts",
    "lint": "next lint"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^13.3.0",
    "next": "^14.2.0",
    "node-cron": "^3.0.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "tsx": "^4.22.2"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
