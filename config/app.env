# 本文件不会自动被 Next 加载；首次 npm install 会复制为根目录 .env.local。
# 日常请直接编辑根目录 .env.local（或改此处后再 cp 到 .env.local）。百度/Bing 密钥勿提交 git。
# NEXT_PUBLIC_SITE_URL：站点根 URL，需可访问 /sitemap.xml
NEXT_PUBLIC_SITE_URL=https://www.ai-code8.com

AUDIT_USER_AGENT=SEO-Monitor/1.0
# 单次 API 审计中 Lighthouse 最多扫描页数（较慢）
AUDIT_LIGHTHOUSE_MAX_PAGES=3
# site-audit-seo CLI 默认最多爬取页数
AUDIT_SITE_AUDIT_MAX_PAGES=25

# --- 以下为选填；取消注释并填写后重启 npm run dev / npm start ---

# 审计 API 保护（设置后审计页与百度推送需填同一密钥）
# AUDIT_RUN_SECRET=

# Bing Webmaster（设置 → API 访问）
# BING_WEBMASTER_API_KEY=

# 百度主动推送：推荐整段粘贴资源平台「接口调用地址」（site 用纯域名 www.example.com）
# BAIDU_PUSH_API_URL=http://data.zz.baidu.com/urls?site=www.example.com&token=xxxx

# 或分项（与整段 URL 二选一）
# BAIDU_PUSH_TOKEN=
# BAIDU_PUSH_SITE=

# 百度手动/Sitemap 推送默认地址（与定时任务一致；改后需重启 npm run dev）
BAIDU_DEFAULT_SITEMAP_URL=https://www.ai-code8.com/sitemap.xml

# 百度 Sitemap 定时推送（npm run schedule:daemon 或系统 cron + npm run schedule:run）
BAIDU_SCHEDULE_ENABLED=true
BAIDU_SCHEDULE_TIME=03:00
BAIDU_SCHEDULE_SITEMAP_URL=https://www.ai-code8.com/sitemap.xml
# 可选：与 sitemap 不同域时显式指定百度站长「站点」；默认同 sitemap 域名
# BAIDU_SCHEDULE_PUSH_SITE=https://www.ai-code8.com
BAIDU_SCHEDULE_MAX_PAGES=2000
BAIDU_SCHEDULE_TIMEZONE=Asia/Shanghai
