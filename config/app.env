# 本文件不会自动被 Next 加载；npm install 会复制为 .env.local。
# 站点列表见 config/sites.json；各站密钥见 config/sites-secrets.json（勿提交 git）。

NEXT_PUBLIC_SITE_URL=https://www.ai-code8.com

AUDIT_USER_AGENT=SEO-Monitor/1.0
AUDIT_LIGHTHOUSE_MAX_PAGES=3
AUDIT_SITE_AUDIT_MAX_PAGES=25

# 审计 API 保护（设置后审计/推送 API 需 Bearer 同一密钥）
# AUDIT_RUN_SECRET=

# 全局定时开关（各站时间与额度在 config/sites.json）
BAIDU_SCHEDULE_ENABLED=true
BAIDU_SCHEDULE_TIME=03:00
BAIDU_SCHEDULE_TIMEZONE=Asia/Shanghai
