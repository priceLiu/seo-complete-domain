# 复制为 config/secrets.env（已 gitignore），填写真实值后：npm run env:sync

# 推荐：整段「接口调用地址」（去掉行首 #）
# BAIDU_PUSH_API_URL=http://data.zz.baidu.com/urls?site=www.ai-code8.com&token=你的token

# 或分项（与旧云函数 BAIDU_TOKEN / BAIDU_SITE_URL 同名）
# BAIDU_TOKEN=
# BAIDU_SITE_URL=https://www.ai-code.com

# BING_WEBMASTER_API_KEY=
