# 与 config/app.env 说明一致；密钥只放 .env.local（勿提交）
NEXT_PUBLIC_SITE_URL=https://www.ai-code8.com

# 可选：服务端跑审计时请求来源（部分站点校验 UA）
AUDIT_USER_AGENT=SEO-Monitor/1.0

# 可选：跑全站审计时的密钥。若设置，则 POST /api/audit/run 需传 Authorization: Bearer <密钥> 或 JSON body.secret
# AUDIT_RUN_SECRET=

# 可选：Bing Webmaster API（仅服务端，勿用 NEXT_PUBLIC_ 前缀）
# BING_WEBMASTER_API_KEY=

# 可选：百度主动推送 — 推荐整段粘贴资源平台「接口调用地址」（已含 site、token，站点验证后可直用）
# BAIDU_PUSH_API_URL=http://data.zz.baidu.com/urls?site=https%3A%2F%2Fwww.example.com&token=xxxx

# 可选：或分项配置（与平台 API 地址中的参数一致）
# BAIDU_PUSH_TOKEN=
# BAIDU_PUSH_SITE=

# 定时 Sitemap 推送（默认每天 03:00，地址 https://www.ai-code8.com/sitemap.xml）
# BAIDU_SCHEDULE_ENABLED=true
# BAIDU_SCHEDULE_TIME=03:00
# BAIDU_SCHEDULE_SITEMAP_URL=https://www.ai-code8.com/sitemap.xml
# BAIDU_SCHEDULE_MAX_PAGES=2000
# BAIDU_SCHEDULE_TIMEZONE=Asia/Shanghai
